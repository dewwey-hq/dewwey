  "about": {
    "text": "A former paper mill transformed into a 25,000-square-foot event space in Chicago's Pilsen neighborhood, named for Mickey Geraghty Kehoe by her son, event designer Tom Kehoe. Uncompromising in its luxury and infinite details, the venue is completely customizable — one open floor with 22-foot ceilings, reconfigured for every event.",
    "evidence": {
      "source_url": "https://thegeraghty.com/about/",
      "snapshot_id": null
    }
