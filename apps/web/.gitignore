# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# GCP service account keys (never commit)
*-key.json
*-sa.json
google-credentials.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
lambdas/vendor-search/node_modules
response.json
scripts/*.tsv

# local secrets (SA keys)
secrets/

# venue enrichment crawl/LLM artifacts (regenerable)
scripts/venue-enrichment/sample-output/

# lambda deploy zip (build locally)
lambdas/vendor-search/function.zip
