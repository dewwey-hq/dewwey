# Copy to .env.local for day-to-day dev (point at beta, not prod).
# Optional: .env.beta and .env.prod when WEDDING_APP_ENV=beta|prod.

# ── App (Next.js / Vercel) ───────────────────────────────────────────────────
# Vendor API base URL — no trailing slash. Set per Vercel environment.
# Beta (local dev default): https://rm4ubmuksa.execute-api.us-east-1.amazonaws.com/vendors
# Prod: https://kfln0omb31.execute-api.us-east-1.amazonaws.com/vendors
NEXT_PUBLIC_VENDOR_API_URL=https://rm4ubmuksa.execute-api.us-east-1.amazonaws.com/vendors

# Beta-only: enables /beta-access gate (leave unset on production).
BETA_ACCESS_PASSWORD=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Database (scripts + Lambda) ────────────────────────────────────────────
# Local scripts: use beta credentials by default.
DB_HOST=wedding-app-beta-db.CHANGE_ME.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Required only when intentionally touching prod from a script:
# ALLOW_PROD_DB=true

# ── Google (server-side scripts / API routes) ──────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_SERVER_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Enrichment / scraping ───────────────────────────────────────────────────
APIFY_API_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
