# Supabase — Postgres (transaction pooler) + Auth.
# Anon key is public by design; row-level security enforces access.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter - for LLMs
OPENROUTER_API_KEY=

# Apify
APIFY_API_TOKEN=

# Google Maps (browser key, referrer-restricted) — the map UI only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Cloudflare R2 — avatars + venue photos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dewwey
NEXT_PUBLIC_R2_PUBLIC_URL=
