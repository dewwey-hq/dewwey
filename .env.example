# Supabase Postgres (Dewwey org, us-east-1).
# Pooled connection string: Dashboard → Connect → Transaction pooler.
DATABASE_URL=

# OpenRouter - for LLMs
OPENROUTER_API_KEY=

# Apify
APIFY_API_TOKEN=

# Google Maps (browser key, referrer-restricted) — the map UI only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Places (server key) — seed/refresh scripts only, never runtime.
GOOGLE_PLACES_SERVER_API_KEY=

# Cloudflare R2 — avatars + venue photos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dewwey
NEXT_PUBLIC_R2_PUBLIC_URL=
